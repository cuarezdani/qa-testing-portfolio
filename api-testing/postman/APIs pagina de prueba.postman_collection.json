  "item": [
    {
      "name": "01 - GET - Consultar usuario por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const respuesta = pm.response.json();\r",
              "const userId = Number(pm.environment.get(\"userId\"));\r",
              "\r",
              "if (userId <= 10) {\r",
              "\r",
              "    pm.test(\"Status code es 200\", function () {\r",
              "        pm.response.to.have.status(200);\r",
              "    });\r",
              "\r",
              "    pm.test(\"El ID recibido corresponde al solicitado\", function () {\r",
              "        pm.expect(respuesta.id).to.eql(userId);\r",
              "    });\r",
              "\r",
              "    pm.test(\"El usuario contiene los campos requeridos\", function () {\r",
              "        pm.expect(respuesta).to.have.property(\"id\");\r",
              "        pm.expect(respuesta).to.have.property(\"name\");\r",
              "        pm.expect(respuesta).to.have.property(\"username\");\r",
              "        pm.expect(respuesta).to.have.property(\"email\");\r",
              "    });\r",
              "\r",
              "} else {\r",
              "\r",
              "    pm.test(\"Status code es 404\", function () {\r",
              "        pm.response.to.have.status(404);\r",
              "    });\r",
              "\r",
              "    pm.test(\"La respuesta está vacía\", function () {\r",
              "        pm.expect(respuesta).to.be.an(\"object\");\r",
              "        pm.expect(Object.keys(respuesta)).to.have.lengthOf(0);\r",
              "    });\r",
              "\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - POST - Crear usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const usuario = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code es 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"La respuesta contiene un ID\", function () {\r",
              "    pm.expect(usuario.id).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"Los datos del usuario son correctos\", function () {\r",
              "    pm.expect(usuario.name).to.eql(\"Daniela QA\");\r",
              "    pm.expect(usuario.username).to.eql(\"danielaqa\");\r",
              "    pm.expect(usuario.email).to.eql(\"daniela@example.com\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"name\": \"Daniela QA\",\r\n    \"username\": \"danielaqa\",\r\n    \"email\": \"daniela@example.com\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 - PUT - Actualizar usuario",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const usuario = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code es 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"El ID del usuario es correcto\", function () {\r",
              "    pm.expect(usuario.id).to.eql(1);\r",
              "});\r",
              "\r",
              "pm.test(\"Los datos fueron actualizados correctamente\", function () {\r",
              "    pm.expect(usuario.name).to.eql(\"Daniela QA Actualizada\");\r",
              "    pm.expect(usuario.username).to.eql(\"danielaqa\");\r",
              "    pm.expect(usuario.email).to.eql(\"daniela.actualizada@example.com\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"name\": \"Daniela QA Actualizada\",\r\n    \"username\": \"danielaqa\",\r\n    \"email\": \"daniela.actualizada@example.com\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "1"
          ]
        }
      },
      "response": []
